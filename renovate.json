{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>nicebots-xyz/renovate-config",
    "local>nicebots-xyz/renovate-config:automerge-python-lockfile"
  ],
  "forkProcessing": "enabled",
  "baseBranchPatterns": [
    "dev"
  ],
  "packageRules": [
    {
      "description": "Match the PDM dependency cooldown (exclude-newer in pyproject.toml), so Renovate never proposes a PyPI release PDM refuses to lock.",
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
