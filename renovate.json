{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>nicebots-xyz/renovate-config",
    "local>nicebots-xyz/renovate-config:automerge-python-lockfile"
  ],
  "forkProcessing": "enabled",
  "baseBranchPatterns": [
    "dev"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Ignore the root compose file, which only holds throwaway services for local testing.",
      "matchFileNames": [
        "compose.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Repositories built on botkit sync their workflows from it, so updates under .github only land in botkit.",
      "matchRepositories": [
        "!nicebots-xyz/botkit"
      ],
      "matchFileNames": [
        ".github/**"
      ],
      "enabled": false
    },
    {
      "description": "Outside botkit, gather non-major PyPI dependency updates into one weekly pull request to save CI minutes. The Python interpreter is not a PyPI package and keeps its own pull request.",
      "matchRepositories": [
        "!nicebots-xyz/botkit"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "Python dependencies",
      "groupSlug": "python-non-major",
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "Outside botkit, gather non-major npm dependency updates into one weekly pull request to save CI minutes.",
      "matchRepositories": [
        "!nicebots-xyz/botkit"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-non-major",
      "schedule": [
        "* 0-5 * * 1"
      ]
    }
  ]
}
